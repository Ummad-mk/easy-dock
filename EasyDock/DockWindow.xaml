<Window x:Class="EasyDock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyDock"
        Title="EasyDock-Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="64"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- App Icon DataTemplate (Apple macOS Fluid Style - Compact 0.7 Width) -->
        <DataTemplate x:Key="AppIconTemplate" DataType="{x:Type local:DockAppItem}">
            <Grid Width="52" Height="46" Margin="0,1">

                <!-- Apple macOS Pearl Active Indicator Pill on Left Edge -->
                <Border Width="2.5" Height="8" CornerRadius="1.2"
                        Background="#FFFFFF"
                        Effect="{StaticResource ActiveIndicatorGlow}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="2,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Parabolic Magnification App Icon Button -->
                <Button Style="{StaticResource DockAppButton}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,3,0"
                        Tag="{Binding}"
                        Click="AppIcon_Click"
                        MouseRightButtonDown="AppIcon_RightClick"
                        MouseEnter="AppIcon_MouseEnter"
                        MouseLeave="AppIcon_MouseLeave"
                        ToolTip="{x:Null}">
                    <Grid Width="28" Height="28">
                        <!-- High-Res Native Icon -->
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Fallback Letter if Icon Unavailable -->
                        <TextBlock Text="{Binding Name, Converter={x:Static local:FirstLetterConverter.Instance}}"
                                   FontFamily="Segoe UI Variable Display, -apple-system, SF Pro Display, Segoe UI"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- Active Focused Window Ambient Ring -->
                <Border CornerRadius="7"
                        BorderThickness="1.2"
                        Margin="7,1,3,1"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="#600A84FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Dock Root Outer Layout -->
    <Grid Margin="0,0,3,0">
        <!-- Floating Glass Deep Drop Shadow -->
        <Border CornerRadius="7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                  Opacity="0.45" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Apple Frosted Glass Dock Body (Spans 70% Screen Height) -->
        <Border x:Name="DockBody"
                Background="{StaticResource AppleGlassBody}"
                BorderBrush="{StaticResource AppleLightCatchingBorder}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="2,8"
                MouseRightButtonDown="DockBody_MouseRightButtonDown">

            <Grid>
                <!-- Collapsed Edge Indicator (Visible only when auto-hidden) -->
                <Border x:Name="CollapsedIndicator"
                        Width="12"
                        Background="#40252A34"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed"
                        ToolTip="Hover to expand EasyDock">
                    <Path Data="M 7 1 L 2 6 L 7 11"
                          Stroke="#0A84FF" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Scrollable / Centered App Stack -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel x:Name="DockContentPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">

                        <!-- Top Pin / Auto-Hide Mode Toggle Button -->
                        <Button x:Name="PinModeBtn"
                                Style="{StaticResource GlassIconButton}"
                                Click="PinModeBtn_Click"
                                Padding="0"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                ToolTip="Toggle Auto-Hide / Keep Always Visible">
                            <Border Width="24" Height="24"
                                    Background="#14FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <!-- Pin Icon -->
                                <Path x:Name="PinIconPath"
                                      Data="M 5 2 L 11 2 M 8 2 L 8 5 L 11 8 L 8 8 L 8 13 M 8 8 L 5 8 L 8 5"
                                      Stroke="#0A84FF" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <Border Height="1" Width="26" Background="#24FFFFFF" Margin="0,0,0,4"/>

                        <!-- Pinned Apps Section (Only Real Windows Pinned Apps) -->
                        <ItemsControl x:Name="PinnedList"
                                      ItemTemplate="{StaticResource AppIconTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Frosted Glass Separator -->
                        <Border x:Name="SeparatorBorder"
                                Height="1"
                                Width="26"
                                Background="#33FFFFFF"
                                Margin="0,4"
                                Visibility="Collapsed"/>

                        <!-- Running Apps Section (Only Real Running Apps Not In Pinned) -->
                        <ItemsControl x:Name="RunningList"
                                      ItemTemplate="{StaticResource AppIconTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Arrow Button [ > ] (Opens Hidden Tray Icons) -->
                        <Border Height="1" Width="26" Background="#24FFFFFF" Margin="0,4,0,3"/>
                        <Button x:Name="ArrowTrayBtn"
                                Style="{StaticResource GlassIconButton}"
                                Click="ArrowTrayBtn_Click"
                                Padding="0"
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                ToolTip="Show Hidden Tray Icons">
                            <Border Width="26" Height="26"
                                    Background="#20FFFFFF"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Path Data="M 1 1 L 5 5 L 1 9"
                                      Stroke="#F2F2F7" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
