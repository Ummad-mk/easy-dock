<Window x:Class="EasyDock.HoverPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyDock-Preview"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="224"
        Height="168"
        WindowStartupLocation="Manual">

    <!-- Outer shadow wrapper -->
    <Grid Margin="8">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Grid.Effect>

        <Border x:Name="CardBorder"
                Background="#E80D1117"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- ── Live DWM Thumbnail Area (rendered by DWM into this region) ── -->
                <!-- This transparent border defines where DWM paints the thumbnail -->
                <Border x:Name="ThumbnailBorder"
                        Grid.Row="0"
                        Background="#12FFFFFF"
                        CornerRadius="7,7,0,0"
                        ClipToBounds="True">
                    <!-- Subtle inner grid pattern to show when thumbnail is not available -->
                    <TextBlock x:Name="NoPreviewText"
                               Text="No preview"
                               Foreground="#30FFFFFF"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Border>

                <!-- ── App Name Footer ── -->
                <Border Grid.Row="1"
                        Background="#18FFFFFF"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,7,7"
                        Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppIcon"
                               Width="16" Height="16"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppNameText"
                                   Foreground="#F2F2F7"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
