<Window x:Class="EasyDock.TopPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyDock-Pill"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Grid Margin="12,0,12,12">
        <!-- Ambient Deep Drop Shadow Layer -->
        <Border CornerRadius="7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                  Direction="270" Opacity="0.45"
                                  Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- 1. CLOSED STATE: Apple Dynamic Island Notch (DEFAULT)     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border x:Name="ClosedPillHandle"
                Width="78" Height="9"
                Background="{StaticResource AppleGlassBody}"
                BorderBrush="{StaticResource AppleLightCatchingBorder}"
                BorderThickness="1"
                CornerRadius="4.5"
                Cursor="Hand"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Visible"
                MouseLeftButtonDown="ClosedPillHandle_Click"
                ToolTip="Click to open Status Bar">
            <Border.RenderTransform>
                <ScaleTransform x:Name="notchScale" ScaleX="1.0" ScaleY="1.0" CenterX="39" CenterY="0"/>
            </Border.RenderTransform>

            <!-- Subtle Inner Horizontal Bar Indicator (Physical Home Bar Metaphor) -->
            <Border Width="28" Height="2"
                    Background="#73FFFFFF"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            <!-- Dynamic Notch Wobble on Hover (Squash & Stretch Spring Physics) -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notchScale"
                                                           Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.15"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.92"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.06"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="0.98"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="1.00"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notchScale"
                                                           Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="0.84"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.12"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="0.94"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="1.02"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="1.00"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- 2. OPENED STATE: Status Bar Pill (7px Border Radius)      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border x:Name="OpenedPillBar"
                Background="{StaticResource AppleGlassBody}"
                BorderBrush="{StaticResource AppleLightCatchingBorder}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="8,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Cursor="SizeAll">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. [<] Arrow from Taskbar (Opens Hidden Tray Flyout) -->
                <Button x:Name="ArrowTrayBtn"
                        Style="{StaticResource GlassIconButton}"
                        Click="ArrowTrayBtn_Click"
                        Padding="6,4"
                        Margin="1,0"
                        ToolTip="Hidden Icons (System Tray)">
                    <Path Data="M 6 1 L 1 6 L 6 11"
                          Stroke="#F2F2F7" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 2. [🎚️] Sliders (Apple Control Center Metaphor - Win+A) -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Sliders_Click"
                        Padding="6,4"
                        Margin="2,0"
                        ToolTip="Control Center (Win+A)">
                    <Canvas Width="16" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Top Track & Knob -->
                        <Line X1="1" Y1="4" X2="15" Y2="4" Stroke="#F2F2F7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="4" Canvas.Top="2" Width="4" Height="4" Fill="#FFFFFF" Stroke="#0D1117" StrokeThickness="0.8"/>
                        <!-- Bottom Track & Knob -->
                        <Line X1="1" Y1="10" X2="15" Y2="10" Stroke="#F2F2F7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="10" Canvas.Top="8" Width="4" Height="4" Fill="#FFFFFF" Stroke="#0D1117" StrokeThickness="0.8"/>
                    </Canvas>
                </Button>

                <!-- 3. [🔊] Speaker / Volume -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Volume_Click"
                        Padding="6,4"
                        Margin="2,0"
                        ToolTip="Sound &amp; Volume">
                    <Canvas Width="16" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 1 4.5 L 3.5 4.5 L 7 1.5 L 7 12.5 L 3.5 9.5 L 1 9.5 Z" Fill="#F2F2F7"/>
                        <Path Data="M 9.5 4.5 A 3.5 3.5 0 0 1 9.5 9.5" Stroke="#F2F2F7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 12 2.5 A 6.5 6.5 0 0 1 12 11.5" Stroke="#F2F2F7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Button>

                <!-- 4. [🔋] Battery Icon (Apple System Green #34C759 + Charging Bolt) -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Battery_Click"
                        Padding="6,4"
                        Margin="2,0"
                        ToolTip="Battery Status">
                    <Grid Width="22" Height="12">
                        <!-- Battery Outer Casing -->
                        <Border Width="19" Height="12" CornerRadius="2.5"
                                BorderBrush="#34C759" BorderThickness="1.4"
                                HorizontalAlignment="Left" Background="#1A000000">
                            <!-- Green Inner Fill -->
                            <Border x:Name="BatteryFill"
                                    Width="15" Height="8" CornerRadius="1"
                                    Background="#34C759"
                                    HorizontalAlignment="Left" Margin="1,0.5"/>
                        </Border>
                        <!-- Terminal Nub -->
                        <Border Width="2" Height="5" CornerRadius="0,1,1,0"
                                Background="#34C759"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,1,0"/>
                        <!-- Lightning Bolt -->
                        <Path x:Name="BatteryBolt"
                              Data="M 6 1 L 3 5 L 6 5 L 4 9 L 8 4 L 5 4 Z"
                              Fill="#FFFFFF" Width="7" Height="9" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Visible"/>
                    </Grid>
                </Button>

                <!-- 5. Date & Time: "Tue Nov 17  8:29 PM" (Apple Optical Sizing & Hierarchy) -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Clock_Click"
                        Padding="10,3"
                        Margin="4,0"
                        ToolTip="Calendar &amp; Time">
                    <TextBlock x:Name="DateTimeText"
                               Text="Tue Nov 17  8:29 PM"
                               FontFamily="Segoe UI Variable Display, -apple-system, SF Pro Display, Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </Button>

                <!-- 6. [🔔] Notification Bell with Apple Red Badge Dot -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Notifications_Click"
                        Padding="6,4"
                        Margin="2,0"
                        ToolTip="Notification Center (Win+N)">
                    <Grid Width="16" Height="15">
                        <!-- Bell Outline Vector -->
                        <Path Data="M 8 1 C 6 1 4.5 2.5 4.5 4.5 L 4.5 7.5 L 3 9.5 L 13 9.5 L 11.5 7.5 L 11.5 4.5 C 11.5 2.5 10 1 8 1 Z M 6.5 11 C 6.5 11.8 7.2 12.5 8 12.5 C 8.8 12.5 9.5 11.8 9.5 11 Z"
                              Stroke="#F2F2F7" StrokeThickness="1.3"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Apple System Red Dot (#FF3B30) -->
                        <Ellipse Width="5.5" Height="5.5"
                                 Fill="#FF3B30"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-1,-1,0"/>
                    </Grid>
                </Button>

                <!-- 7. [♫] Music / Media Note -->
                <Button Style="{StaticResource GlassIconButton}"
                        Click="Media_Click"
                        Padding="6,4"
                        Margin="2,0"
                        ToolTip="Media &amp; Music">
                    <Path Data="M 3 10 A 2 2 0 1 1 5 8.5 L 5 2.5 L 12 1.5 L 12 8 A 2 2 0 1 1 14 6.5 L 14 0.5 L 4 1.8 L 4 8.5 Z"
                          Fill="#F2F2F7" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 8. [^] Collapse Arrow to Hide Back to Notch (From Image 2) -->
                <Button x:Name="CollapseBtn"
                        Style="{StaticResource GlassIconButton}"
                        Click="CollapseBtn_Click"
                        Padding="6,4"
                        Margin="2,0,1,0"
                        ToolTip="Collapse to Pill">
                    <Path Data="M 1 6 L 6 1 L 11 6"
                          Stroke="#F2F2F7" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
