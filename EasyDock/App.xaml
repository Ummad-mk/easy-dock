<Application x:Class="EasyDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- APPLE DESIGN FOUNDATIONS: Translucent Materials & Depth              -->
        <!-- ════════════════════════════════════════════════════════════════════ -->

        <!-- Apple Glass Body: Deep translucent obsidian with vibrancy -->
        <SolidColorBrush x:Key="AppleGlassBody" Color="#E60D1117"/>

        <!-- Light-Catching Edge: Bright top rim reflecting ambient light -->
        <LinearGradientBrush x:Key="AppleLightCatchingBorder" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#59FFFFFF" Offset="0.0"/>
            <GradientStop Color="#28FFFFFF" Offset="0.5"/>
            <GradientStop Color="#14FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Active Running Indicator Glow (Pearl White) -->
        <DropShadowEffect x:Key="ActiveIndicatorGlow"
                          BlurRadius="6" ShadowDepth="0"
                          Opacity="0.85" Color="#FFFFFF"/>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- 1. Apple-Style Fluid Icon Button (Instant response on pointer-down)  -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="grid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="bg"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover: Gentle Lift + Ambient Light (Apple Damping 1.0) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#24FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#30FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.06" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.06" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Press: Instant Tactile Squash (Apple Rule 1 - Kill Latency) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.93" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.93" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- 2. Apple macOS Dock App Button (Parabolic Magnification & Bounce)   -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Style x:Key="DockAppButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Width"            Value="38"/>
            <Setter Property="Height"           Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="iconScale" ScaleX="1.0" ScaleY="1.0"
                                                CenterX="19" CenterY="19"/>
                            </Grid.RenderTransform>

                            <!-- Apple Glass Chip Layer -->
                            <Border x:Name="bg"
                                    Background="#14FFFFFF"
                                    CornerRadius="10"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover: Fluid Scale Up (Damping 0.9, Response 0.18s) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#2BFFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#55FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.16" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.25" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.16" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.25" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Press: Physical Depress on Pointer-Down (Instant tactile feedback) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#45FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.92" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.92" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
